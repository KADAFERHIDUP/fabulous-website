# Dependensi & file lokal
/vendor/
/_ci4_base/
.env
.phpunit.result.cache

# Isi folder writable (cache, log, session, upload sementara)
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
/writable/debugbar/*
!/writable/debugbar/index.html

# Salinan frontend yang dibuat installer (sumber aslinya di ../frontend)
/public/index.html
/public/js/
/public/css/style.css
/public/img/
/public/data/
/public/vendor/

# Foto mobil yang diupload lewat panel admin
/public/uploads/*
!/public/uploads/.gitkeep

.DS_Store
Thumbs.db
.idea/
.vscode/
